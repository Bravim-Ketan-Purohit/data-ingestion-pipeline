# API Keys
ANTHROPIC_API_KEY=

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:7804
S3_BUCKET=documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# KMS (for client-side envelope encryption)
KMS_KEY_ID=
KMS_ENDPOINT_URL=

# Postgres
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:7802/pipeline

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:7808

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:7811
OTEL_SERVICE_NAME=data-ingestion-pipeline

# Rate limits (Claude API)
CLAUDE_RPM_LIMIT=50
CLAUDE_TPM_LIMIT=100000
CLAUDE_CONCURRENCY_LIMIT=5
CLAUDE_COST_CEILING_USD=50.0

# App
APP_ORIGIN=http://localhost:7800
LOG_LEVEL=INFO
